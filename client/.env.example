# 디자이너 구하기·로그인 백엔드 (IROKE_backend). 끝에 /api까지 적는다.
# 개발 모드에서 비우면 http://localhost:8788/api (IROKE_backend를 PORT=8788로 띄운 것)를 쓴다.
# 배포(Vercel)에서는 꼭 넣는다. 예: https://iroke-backend.vercel.app/api
VITE_API_V2_URL=

# 카카오 REST API 키 (인가 요청의 client_id로만 쓴다. 비밀키는 백엔드에만)
# 카카오 개발자 콘솔 Redirect URI에 {사이트 주소}/auth/kakao/callback 을 등록해야 한다.
# 비우면 개발 모드에서 /api/auth/dev(백엔드 memory 모드의 시드 계정)로 로그인한다:
#   디자이너 화면(/pro…)에서 로그인 → 인증 디자이너 '서윤 디자이너', 그 밖 → 손님 '하린'
VITE_KAKAO_REST_API_KEY=
